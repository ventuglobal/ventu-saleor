# ─────────────── Saleor core (api) ───────────────
# Genera con: openssl rand -hex 32
SECRET_KEY=change-me
# En Railway, DATABASE_URL / REDIS_URL los inyectan los plugins de Postgres/Redis.
DATABASE_URL=postgres://saleor:saleor@db:5432/saleor
REDIS_URL=redis://redis:6379/0
# OBLIGATORIA. Saleor NO usa REDIS_URL como broker: sin esta variable cae a
# task_always_eager y ejecuta cada tarea "asíncrona" dentro del worker web.
# Va en OTRA db de Redis que el caché (0 = caché, 1 = broker) para que un
# flush del caché no se lleve la cola por delante.
CELERY_BROKER_URL=redis://redis:6379/1
# Procesos por servicio. Subir solo con evidencia de saturación: cada uno es un
# proceso Django completo (~250 MB medidos sobre la imagen 3.20).
SALEOR_WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_CLIENT_HOSTS=localhost,127.0.0.1
DEFAULT_FROM_EMAIL=no-reply@ventu.cl
# URL pública de la API (para el dashboard y storefront)
PUBLIC_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:9000/

# ─────────────── Dashboard ───────────────
# Endpoint GraphQL que consume el dashboard
API_URL=http://localhost:8000/graphql/

# ─────────────── Ventu Sync App ───────────────
# A dónde reenvía las órdenes de Saleor (backend Ventu)
VENTU_API_URL=https://api.ventu.cl
# Token con el que ventu-sync autentica contra el backend Ventu
VENTU_API_TOKEN=change-me
# Secreto compartido para validar el webhook de Saleor (opcional pero recomendado)
SALEOR_WEBHOOK_SECRET=change-me
# URL pública de la API de Saleor (para llamadas salientes del sync app)
SALEOR_API_URL=http://localhost:8000/graphql/
# Miniaturas a calentar al publicar. Los defaults son exactamente lo que pide el
# storefront (1024 y 2048, ambas WEBP); cada par (tamaño, formato) extra es un
# decode+resize de Pillow por foto. Vacío desactiva el calentamiento.
THUMBNAIL_WARM_SIZES=1024,2048
THUMBNAIL_WARM_FORMATS=webp

# ─────────────── Referencia: backend Ventu (channel_sync) ───────────────
# Estas van en el .env del backend Ventu, NO aquí. Se listan como recordatorio:
#   SALEOR_API_URL=https://<host>/graphql/
#   SALEOR_AUTH_TOKEN=<token de la Saleor App>
#   SALEOR_WAREHOUSE_ID=<gid del warehouse VENTU>
#   SALEOR_WAREHOUSE_SLUG=VENTU

# ─────────────── Storefront (Next.js oficial, ./storefront) ───────────────
# NEXT_PUBLIC_* son build-time en producción (Railway build env). La API URL
# debe ser alcanzable desde el navegador (no el hostname interno de compose).
NEXT_PUBLIC_SALEOR_API_URL=http://localhost:8000/graphql/
NEXT_PUBLIC_DEFAULT_CHANNEL=retail-cl
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
